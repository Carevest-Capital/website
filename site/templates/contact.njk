{% extends "layout.njk" %}
{% import "_macros.njk" as m %}

{% block main %}
  {% set h = s.hero %}
  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero" data-section="hero">
    <div class="wrap page-hero__in">
      <p class="eyebrow">{{ h.eyebrow }}</p>
      <h1>{{ h.headline | accent }}</h1>
      <p class="sub">{{ h.sub }}</p>
    </div>
  </section>

  {% if shown('form') or shown('details') %}
  <!-- ============ FORM + DETAILS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="split-uneven split-uneven--top">
        {% if shown('form') %}
        {% set f = s.form %}
        <div class="card reveal" data-section="form">
          <p class="eyebrow">{{ f.eyebrow }}</p>
          <form class="form" data-endpoint="/api/contact" style="margin-top:18px;" novalidate>
            <div class="field">
              <label for="ct-type">{{ f.selection_label or 'Selection' }} *</label>
              <select id="ct-type" name="kind" required>
                <option value="">Please select</option>
                <option value="new_investor">New Investor</option>
                <option value="borrower">Borrower</option>
                <option value="general">General Inquiries</option>
              </select>
            </div>
            <div class="form-row">
              <div class="field"><label for="ct-fn">First name *</label><input id="ct-fn" name="first_name" type="text" autocomplete="given-name" required /></div>
              <div class="field"><label for="ct-ln">Last name *</label><input id="ct-ln" name="last_name" type="text" autocomplete="family-name" required /></div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="ct-prov">Province *</label>
                <select id="ct-prov" name="province" required>
                  <option value="">Please select</option>
                  <option>British Columbia</option>
                  <option>Alberta</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="field"><label for="ct-em">Email *</label><input id="ct-em" name="email" type="email" autocomplete="email" required /></div>
            </div>
            <div class="field"><label for="ct-msg">Message</label><textarea id="ct-msg" name="message" placeholder="Leave your message here..."></textarea></div>
            <div class="field" style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;" aria-hidden="true"><label for="ct-web">Website</label><input id="ct-web" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
            <button class="btn btn--accent" type="submit" style="justify-content:center;">{{ f.button_label }}</button>
            <p class="form-confirm" hidden style="color:var(--accent); font-weight:500;">{{ f.confirm }}</p>
            <p class="form-error" hidden style="color:#B4322D; font-weight:500;">{{ f.error or 'Sorry, your message could not be sent. Please email us directly.' }}</p>
            <p class="fine">{{ f.consent }}</p>
          </form>
        </div>
        {% endif %}
        {% if shown('details') %}
        {% set d = s.details %}
        <div data-section="details" style="display:grid; gap:20px;">
          {% set phone1 = g.phone_investor_relations if d.ir_phone is undefined else d.ir_phone %}
          <div class="card reveal">
            <p class="eyebrow eyebrow--muted">{{ d.ir_heading }}</p>
            {% if phone1 %}<p style="font-size:var(--s2); font-weight:300; margin-top:8px;" class="tnum">{{ phone1 }}</p>{% endif %}
            <p style="color:var(--muted); font-size:0.92rem; margin-top:8px;">{{ d.ir_emails }}</p>
          </div>
          {% for o in items('details') %}<div class="card reveal">
            <p class="eyebrow eyebrow--muted">{{ o.name }}</p>
            <p style="color:var(--muted); margin-top:10px;">{{ o.street }}<br />{{ o.city_line }}</p>
            <p style="color:var(--muted); margin-top:8px;">{{ o.phone_label }}: {{ o.phone }}</p>
          </div>
          {% endfor %}<div class="card reveal">
            <p class="eyebrow eyebrow--muted">{{ d.borrowers_heading }}</p>
            {% if d.borrowers_phone %}<p style="font-size:var(--s2); font-weight:300; margin-top:8px;" class="tnum">{{ d.borrowers_phone }}</p>{% endif %}
            <p style="color:var(--muted); margin-top:{% if d.borrowers_phone %}8px; font-size:0.92rem{% else %}10px{% endif %};">{{ d.borrowers_email }}</p>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}
{% endblock %}
