{% extends "layout.njk" %}
{% import "_macros.njk" as m %}

{% block main %}
  {% set h = s.hero %}
  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="wrap page-hero__in">
      <p class="eyebrow">{{ h.eyebrow }}</p>
      <h1>{{ h.headline | accent }}</h1>
      <p class="sub">{{ h.sub }}</p>
    </div>
  </section>

  <!-- ============ DOWNTOWN IMAGE ============ -->
  <section class="section--tight">
    <div class="wrap">
      <figure class="photo photo--wide reveal"><img src="{{ s.image_band.image.src }}" alt="{{ s.image_band.image.alt }}" loading="lazy" /></figure>
    </div>
  </section>

  <!-- ============ TIMELINE ============ -->
  <section class="section">
    <div class="wrap wrap--narrow">
      <div class="timeline">
        {% for t in items('timeline') %}<div class="tl-item reveal"{% if loop.first %} style="border-top:0;"{% endif %}>
          <div class="year{% if t.year | numeric %} tnum{% endif %}">{{ t.year }}</div>
          <div>
            <h3>{{ t.heading }}</h3>
            <p>{{ t.body }}</p>
            {% if t.note %}<div class="note" style="margin-top:16px;">{{ t.note | inlinep }}</div>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% set n = s.numbers %}
  <!-- ============ NUMBERS ============ -->
  <section class="section section--band">
    <div class="wrap">
      <p class="eyebrow reveal">{{ n.eyebrow }}</p>
      <h2 class="section-h reveal">{{ n.headline | accent }}</h2>
      <div class="statrow reveal" style="margin-top:44px;">
        {% for item in n.stats %}{{ m.stat(item) }}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      {{ m.ctaband(s.cta) }}
    </div>
  </section>
{% endblock %}
