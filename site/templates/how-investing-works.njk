{% extends "layout.njk" %}
{% import "_macros.njk" as m %}

{% block main %}
  {% set h = s.hero %}
  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="wrap page-hero__in">
      <p class="eyebrow">{{ h.eyebrow }}</p>
      <h1>{{ h.headline | accent }}</h1>
      <p class="sub">{{ h.sub }}</p>
    </div>
  </section>

  {% set d = s.dealer %}
  <!-- ============ ABOUT THE DEALER ============ -->
  <section class="section">
    <div class="wrap">
      <div class="grid g2" style="gap:44px; align-items:start;">
        <div>
          <p class="eyebrow reveal">{{ d.eyebrow }}</p>
          <h2 class="section-h reveal">{{ d.headline | accent }}</h2>
          <p class="section-sub reveal">{{ d.body_1 }}</p>
          <p class="section-sub reveal" style="margin-top:14px;">{{ d.body_2 }}</p>
          <p class="section-sub reveal" style="margin-top:14px;">{{ d.body_3 }}</p>
          <p class="section-sub reveal" style="margin-top:14px;">{{ d.phone_lead }} <a href="tel:{{ d.phone | tel }}" style="color:var(--accent); text-decoration:none; font-weight:500;">{{ d.phone }}</a>.</p>
        </div>
        <div style="display:grid; gap:20px;">
          {% for c in d.cards %}<div class="card reveal">
            <p class="eyebrow eyebrow--muted">{{ c.eyebrow }}</p>
            <p style="color:var(--muted); margin-top:12px;">{{ c.body }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {% set st = s.steps %}
  <!-- ============ THREE STEPS ============ -->
  <section class="section section--surface">
    <div class="wrap">
      <p class="eyebrow reveal">{{ st.eyebrow }}</p>
      <h2 class="section-h reveal">{{ st.headline | accent }}</h2>
      <div class="steps reveal" style="margin-top:36px;">
        {% for step in st.steps %}{{ m.step(step, loop.index) }}
        {% endfor %}
      </div>
    </div>
  </section>

  {% set fq = s.faq %}
  <!-- ============ FAQ ============ -->
  <section class="section" id="faq">
    <div class="wrap wrap--narrow">
      <p class="eyebrow reveal">{{ fq.eyebrow }}</p>
      <h2 class="section-h reveal">{{ fq.headline | accent }}</h2>
      <div class="faq reveal" style="margin-top:36px;">

        {% for f in items('faq') %}{{ m.faq(f) }}

        {% endfor %}
      </div>
    </div>
  </section>

  {% set il = s.industry_links %}
  {% set cp = s.complaints %}
  <!-- ============ INDUSTRY LINKS ============ -->
  <section class="section section--surface" id="industry-links">
    <div class="wrap">
      <div class="grid g2" style="gap:44px; align-items:start;">
        <div>
          <p class="eyebrow reveal">{{ il.eyebrow }}</p>
          <h2 class="section-h reveal">{{ il.headline | accent }}</h2>
          <p class="section-sub reveal">{{ il.body }}</p>
          <ul class="checklist reveal" style="margin-top:22px;">
            {% for l in items('industry_links') %}<li><span class="mrk">&rarr;</span> <a href="{{ l.url }}" style="color:var(--fg);">{{ l.label }}</a></li>
            {% endfor %}
          </ul>
          <p class="fine reveal" style="margin-top:18px;">{{ il.fine }}</p>
        </div>
        <div class="card reveal" id="complaints">
          <p class="eyebrow eyebrow--muted">{{ cp.eyebrow }}</p>
          <p style="color:var(--muted); margin-top:12px; font-size:0.95rem;">{{ cp.body_1 }}</p>
          <p style="color:var(--muted); margin-top:12px; font-size:0.95rem;">{{ cp.body_2 }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="section">
    <div class="wrap">
      {{ m.ctaband(s.final_cta) }}
    </div>
  </section>
{% endblock %}
