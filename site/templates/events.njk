{% extends "layout.njk" %}
{% import "_macros.njk" as m %}

{% block main %}
  {% set ev = items('hero') | first %}
  {% set r = s.registration %}
  <!-- ============ PAGE HERO + REGISTRATION ============ -->
  <section class="page-hero">
    <div class="wrap page-hero__in">
      <div class="hero" style="padding-block:0;">
        <div>
          <p class="eyebrow">{{ ev.series }} &middot; {{ ev.city }}</p>
          <h1>{{ ev.title | accent }}</h1>
          <p class="sub">{{ ev.summary }}</p>
          <div style="margin-top:26px; display:flex; flex-wrap:wrap; gap:14px 30px; font-size:0.85rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--band-muted);">
            <span><b style="color:var(--band-fg); font-weight:500;">Date:</b> {{ ev.date_text }}</span>
            <span><b style="color:var(--band-fg); font-weight:500;">Location:</b> {{ ev.location }}</span>
            <span><b style="color:var(--band-fg); font-weight:500;">Cost:</b> {{ ev.cost }}</span>
          </div>
        </div>
        <div class="card" style="box-shadow:0 40px 90px -50px rgba(0,0,0,0.6);">
          <p class="eyebrow">{{ r.eyebrow }}</p>
          <form class="form" data-demo style="margin-top:16px;">
            <div class="form-row">
              <div class="field"><label for="ev-fn">First name</label><input id="ev-fn" type="text" autocomplete="given-name" required /></div>
              <div class="field"><label for="ev-ln">Last name</label><input id="ev-ln" type="text" autocomplete="family-name" required /></div>
            </div>
            <div class="field"><label for="ev-em">Email</label><input id="ev-em" type="email" autocomplete="email" required /></div>
            <div class="form-row">
              <div class="field">
                <label for="ev-city">City</label>
                <select id="ev-city"><option>Vancouver</option><option>Calgary</option><option>Other</option></select>
              </div>
              <div class="field">
                <label for="ev-guests">Bringing a guest?</label>
                <select id="ev-guests"><option>Just me</option><option>+1 guest</option><option>+2 guests</option></select>
              </div>
            </div>
            <button class="btn btn--accent" type="submit" style="justify-content:center;">{{ r.button_label }} <span class="arw">&rarr;</span></button>
            <p class="form-confirm" hidden style="color:var(--accent); font-weight:500;">{{ r.confirm }}</p>
            <p class="fine">{{ r.consent }}</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ EVENT ATMOSPHERE ============ -->
  <section class="section--tight">
    <div class="wrap">
      <figure class="photo photo--wide reveal"><img src="{{ s.image_band.image.src }}" alt="{{ s.image_band.image.alt }}" loading="lazy" /></figure>
    </div>
  </section>

  {% set w = s.why_attend %}
  <!-- ============ WHY ATTEND ============ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">{{ w.eyebrow }}</p>
      <h2 class="section-h reveal">{{ w.headline | accent }}</h2>
      <div class="grid g3" style="margin-top:36px;">
        {% for c in w.cards %}<div class="card reveal">
          <p class="eyebrow eyebrow--muted">{{ loop.index | pad2 }} &middot; {{ c.eyebrow }}</p>
          <h3 style="font-size:var(--s1); font-weight:400; margin:12px 0 8px;">{{ c.heading }}</h3>
          <p style="color:var(--muted); font-size:0.96rem;">{{ c.body }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {% set rp = s.replay %}
  {% set pe = s.past_events %}
  <!-- ============ REPLAY / PAST EVENTS ============ -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="grid g2">
        <div class="card split-card reveal">
          <p class="eyebrow">{{ rp.eyebrow }}</p>
          <h3>{{ rp.heading }}</h3>
          <p>{{ rp.body }}</p>
          <form class="form" data-demo>
            <div class="field"><label for="rp-em">Email</label><input id="rp-em" type="email" autocomplete="email" required /></div>
            <button class="btn btn--dark" type="submit" style="justify-content:flex-start;">{{ rp.button_label }} <span class="arw">&rarr;</span></button>
            <p class="form-confirm" hidden style="color:var(--accent); font-weight:500;">{{ rp.confirm }}</p>
          </form>
        </div>
        <div class="card split-card reveal">
          <p class="eyebrow">{{ pe.eyebrow }}</p>
          <h3>{{ pe.heading }}</h3>
          <p>{{ pe.body }}</p>
          {{ m.btn(pe.button, 'btn--ghost', true) }}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      {{ m.ctaband(s.cta) }}
    </div>
  </section>
{% endblock %}
